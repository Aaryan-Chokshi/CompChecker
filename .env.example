# Optional non-secret configuration. OPENAI_API_KEY is read from the process
# environment and is intentionally not included in this file.
APP_NAME=Compliance Checker
LOG_LEVEL=INFO
DATABASE_PATH=data/compliance.sqlite3
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
EMBEDDING_MODEL_ID=Alibaba-NLP/gte-large-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=data/models
EMBEDDING_LOCAL_FILES_ONLY=false
EMBEDDING_BATCH_SIZE=8
# Optional Hugging Face commit ID for reproducible model/code downloads.
EMBEDDING_REVISION=
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=policy_chunks
# When set, use a Qdrant server instead of persistent local mode.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=10

# UI reads only UI_* settings; credentials stay in the backend.
UI_API_BASE_URL=http://127.0.0.1:8000/api/v1
UI_API_TIMEOUT_SECONDS=5
UI_HOST=127.0.0.1
UI_PORT=8050
UI_DEBUG=false
